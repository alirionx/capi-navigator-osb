# Configuration of the broker (OSB0-F-01). Copy to .env for local runs; never commit .env.
# Secrets can also be given as files: CAPIN_TOKEN_FILE, BROKER_PASSWORD_FILE (mode 600).

# CAPI Navigator
CAPIN_URL=https://capi-navigator.example.com
CAPIN_CONNECTION=home
CAPIN_TOKEN=capin_replace-me
# CAPIN_TIMEOUT_SECONDS=15

# Credentials Cloud Foundry uses for the broker (cf create-service-broker)
BROKER_USERNAME=broker
BROKER_PASSWORD=replace-me

# Service offering (ADR-0003). Offering ID and label prefix must not change after the first
# instance.
# OFFERING_NAME=kubernetes-cluster
# OFFERING_ID=0b0c9e40-7db5-45ae-a810-f4459a2fad3b
# OFFERING_DESCRIPTION=Kubernetes clusters from CAPI Navigator blueprints
# LABEL_PREFIX=osb.capi-navigator.io
# BLUEPRINT_FILTER=small,cf-*

# Server
# PORT=8080
# HOST=0.0.0.0
# LOG_LEVEL=info
# SWAGGER_UI_ENABLED=true
